# Note: All the variables to this image are optional.
# See README for more information.
# To use, copy this file to 'docling.env' and uncomment/set your values.

# HTTP port for the document conversion API (default: 5001)
# DOCLING_PORT=5001

# API key for authentication.
# - Fresh installs with a mounted /var/lib/docling volume auto-generate a key.
# - Existing installs with no key remain open for backward compatibility.
# - When set, every request must include the header: X-Api-Key: <key>
# - Health and version endpoints (/health, /version) do not require the key.
# - Set explicitly empty (DOCLING_API_KEY=) to disable authentication.
# - Use 'docker exec <container> docling_manage --showkey' to display the key.
# - Use 'docker exec <container> docling_manage --getkey' for scripts.
# - Keep this secret if you expose the server to the internet.
# DOCLING_API_KEY=

# Log level (default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR
# DOCLING_LOG_LEVEL=INFO

# Number of Uvicorn workers (default: 1)
# - Increase for higher throughput on multi-core systems.
# - Each worker loads models independently (higher RAM usage).
# DOCLING_WORKERS=1

# Enable the web UI playground (default: false)
# - When enabled, a demo UI is available at http://<server>:<port>/ui
# DOCLING_ENABLE_UI=false

# Maximum number of pages per document (default: unlimited)
# - Set to limit resource usage on large documents.
# DOCLING_MAX_PAGES=

# Maximum file size for uploads in bytes (default: unlimited)
# - Set to limit resource usage (e.g. 50000000 for ~50 MB).
# DOCLING_MAX_FILE_SIZE=

# Compute device (default: cpu)
# Options: cpu, cuda, auto
# - cpu:   Use CPU for inference (default, works everywhere)
# - cuda:  Use NVIDIA GPU (requires the :cuda image tag and NVIDIA Container Toolkit)
# - auto:  Automatically detect GPU; falls back to CPU if unavailable
# DOCLING_DEVICE=cpu

# Local-only mode: disable all HuggingFace model downloads (default: unset)
# - When set to any non-empty value (e.g. true), only models already cached
#   will be used. Useful for air-gapped or offline deployments.
# DOCLING_LOCAL_ONLY=

# Anonymous aggregate usage counts (default: enabled)
# Set to 1 to disable.
# DOCLING_DISABLE_USAGE_COUNTS=1
